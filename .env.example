# ==========================================
# CareerShift Environment Variables Example
# ==========================================

# Environment (development, testing, production)
ENVIRONMENT=development

# Application Configuration
APP_NAME="CareerShift API"
API_V1_STR="/api/v1"

# Database Configuration (Local PostgreSQL via pgadmin)
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/careershift"

# Security & Authentication
# Generate a secure key (e.g., openssl rand -hex 32)
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"

# Token Expirations (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# CORS Options (comma-separated list of origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# SMTP / Nodemailer equivalent configuration
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST="smtp.example.com"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-smtp-password"
EMAILS_FROM_EMAIL="info@careershift.ai"
EMAILS_FROM_NAME="CareerShift"
