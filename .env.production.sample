# CareerShift Backend — Production Environment Sample
# Copy to .env on your production server and fill in real values.
# Do NOT commit secrets to version control.

# ── Runtime ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
APP_NAME=CareerShift API
API_V1_STR=/api/v1
# Public frontend URL used in report-ready emails (or set FRONTEND_URL).
# If omitted, the first https:// entry in BACKEND_CORS_ORIGINS is used.
APP_PUBLIC_URL=https://careershift3b.com

# ── Database (PostgreSQL) ───────────────────────────────────────────────
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=6543
DB_USER=postgres.kcatnbobjvyytxrauiln
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# ── Security ────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── CORS (comma-separated frontend origins) ─────────────────────────────
BACKEND_CORS_ORIGINS=https://careershift3b.com,https://www.careershift3b.com

# ── Email / SMTP (required in production) ─────────────────────────────
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_USER="viveknath62094@gmail.com"
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="viveknath62094@gmail.com"
EMAILS_FROM_NAME="CareerShift"
REPORT_READY_EMAIL_ENABLED=true

# ── AI (Anthropic — required in production) ───────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TEMPERATURE=0.0
ANTHROPIC_EFFORT=low

# ── Production hardening ────────────────────────────────────────────────
COMPETENCY_PIPELINE_TIMEOUT_SECONDS=600
PIPELINE_STALE_AFTER_SECONDS=900
ASSESSMENT_START_RATE_LIMIT=5
ASSESSMENT_START_RATE_WINDOW_SECONDS=3600
REPORT_GENERATE_RATE_LIMIT=10
REPORT_GENERATE_RATE_WINDOW_SECONDS=3600

# ── Background jobs (optional — enable when scaling) ────────────────────
USE_CELERY=false
# CELERY_BROKER_URL=redis://redis.careershift3B.com:6379/0

# ── Render deployment ───────────────────────────────────────────────────
# Add the variables above in Render → Environment, or upload this file as a
# Secret File named `.env.production` in your Render web service root.
